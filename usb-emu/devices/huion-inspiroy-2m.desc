# Huion Inspiroy 2 M (256c:0067), handled by hid-generic plus the
# udev-hid-bpf program 0010-Huion__Inspiroy-2-M.bpf.c.
#
# Sources: USB layout and the interface 1 (pen, 93 bytes) and interface 2
# (pad, 133 bytes) report descriptors from the tablet-hid-descriptors
# capture 'Huion Inspiroy 2 M/sysinfo.nLrNAqLFy1'. The capture's interface
# 0 descriptor was already rewritten by the BPF program, so the original
# 36-byte vendor descriptor is RECONSTRUCTED here (input report 8, 88
# bits + output report 10); the BPF program only checks its length.
# String 201 matches the program's EXPECTED_FIRMWARE_ID prefix; string
# 200 switches the tablet to vendor mode (report ID 8 on interface 0).

device vid=0x256c pid=0x0067 bcd=0x0112 usb=0x0200 attrs=0xa0 power=100
string 1 "HUION"
string 2 "Huion Tablet_H951P"
string 201 "HUION_T21k_221221"
string-raw 200 13 03 c0 cd 00 a0 82 00 ff 1f d8 13 03 0d 10 01 04 3c 3e
on-read 200 mode raw

interface 0 class=3 subclass=1 protocol=2 ep=0x81 out=0x01 maxpacket=64 interval=1
rdesc 0 06 00 ff 09 01 a1 01 85 08 75 58 95 01 09 01 81 02 c0 06 00 ff 09 01 a1 01 85 0a 75 08 95 0f 09 01 91 02 c0
interface 1 class=3 subclass=1 protocol=2 ep=0x82 maxpacket=16 interval=1
rdesc 1 05 0d 09 02 a1 01 85 0a 09 20 a1 01 09 42 09 44 09 45 09 3c 15 00 25 01
rdesc 1 75 01 95 06 81 02 09 32 75 01 95 01 81 02 81 03 05 01 09 30 09 31 55 0d
rdesc 1 65 33 26 ff 7f 35 00 46 00 08 75 10 95 02 81 02 05 0d 09 30 26 ff 1f 75
rdesc 1 10 95 01 81 02 09 3d 09 3e 15 81 25 7f 75 08 95 02 81 02 c0 c0
interface 2 class=3 subclass=0 protocol=0 ep=0x83 maxpacket=64 interval=1
rdesc 2 05 01 09 06 a1 01 85 03 05 07 19 e0 29 e7 15 00 25 01 75 01 95 08 81 02
rdesc 2 05 07 19 00 29 ff 26 ff 00 75 08 95 06 81 00 c0 05 0c 09 01 a1 01 85 04
rdesc 2 19 00 2a 3c 02 15 00 26 3c 02 95 01 75 10 81 00 c0 05 01 09 02 a1 01 09
rdesc 2 01 85 05 a1 00 05 09 19 01 29 05 15 00 25 01 95 05 75 01 81 02 95 01 75
rdesc 2 03 81 01 05 01 09 30 09 31 16 00 80 26 ff 7f 75 10 95 02 81 06 95 01 75
rdesc 2 08 05 01 09 38 15 81 25 7f 81 06 c0 c0
