# Extra options for the unified tablet stack, merged on top of
# tools/testing/selftests/hid/config by virtme-ng.
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_HID=y
CONFIG_HID_BPF=y
CONFIG_HID_WACOM=y
CONFIG_HID_UCLOGIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_POWER_SUPPLY=y
CONFIG_KUNIT=y
CONFIG_HID_KUNIT_TEST=y
CONFIG_HID_BATTERY_STRENGTH=y
# USB device emulation (usb-emu/): raw-gadget on top of dummy_hcd lets a
# userspace program act as a real USB HID device bound by usbhid, so
# string-descriptor paths (hid-uclogic, HID-BPF) can be tested without
# hardware.
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_RAW_GADGET=y
